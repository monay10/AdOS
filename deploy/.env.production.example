# AdOS production secrets — copy to deploy/.env.production and fill in.
# NEVER commit the real file. All values are read only via @ados/config.

# Postgres
POSTGRES_PASSWORD=change-me-strong

# MinIO / object storage
MINIO_ROOT_USER=ados
MINIO_ROOT_PASSWORD=change-me-strong

# Web session signing (≥ 16 chars, validated at startup)
SESSION_SECRET=change-me-to-a-long-random-string

# Grafana admin
GRAFANA_PASSWORD=change-me
