# ─────────────────────────────────────────────────────────────
# AdOS environment configuration (example)
# Copy to .env and adjust. NO paid cloud service is required.
# ─────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
LOG_LEVEL=debug
SERVICE_NAME=ados

# Multi-tenancy
DEFAULT_TENANT=public
TENANT_HEADER=x-tenant-id

# PostgreSQL (self-hosted)
DATABASE_URL=postgres://ados:ados@localhost:5432/ados

# Redis (cache + queue, self-hosted)
REDIS_URL=redis://localhost:6379

# NATS JetStream (event bus, self-hosted)
NATS_URL=nats://localhost:4222

# Object storage (self-hosted MinIO, S3-compatible)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=ados
STORAGE_SECRET_KEY=ados-secret
STORAGE_BUCKET=ados

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
METRICS_PORT=9464

# ── AI Runtime (OFFLINE-FIRST, local inference only) ──────────
# Primary local inference engine. No internet required.
INFERENCE_PRIMARY=ollama
OLLAMA_URL=http://localhost:11434
VLLM_URL=http://localhost:8000
LLAMACPP_URL=http://localhost:8080
SGLANG_URL=http://localhost:30000
LMSTUDIO_URL=http://localhost:1234

# Default local models per capability (all replaceable via config).
# Mapped to the locally installed model inventory.
MODEL_REASONING=deepseek-r1:32b
MODEL_CHAT=qwen3:32b
MODEL_CHAT_FAST=phi4
MODEL_CHAT_ALT=gemma3:27b
MODEL_GENERAL=llama3
MODEL_CODE=qwen2.5-coder:32b
MODEL_CODE_ALT=deepseek-coder:33b
MODEL_EMBEDDING=nomic-embed-text
MODEL_EMBEDDING_ALT=bge-m3

# Media engines (all local)
STT_MODEL=whisper            # speech-to-text
TTS_MODEL=piper              # text-to-speech
VOICE_CLONE_MODEL=xtts       # voice cloning / narration
IMAGE_ENGINE=comfyui         # orchestrates Flux / Stable Diffusion
COMFYUI_URL=http://localhost:8188
FLUX_MODEL=flux
SD_MODEL=stable-diffusion

# Optional cloud passthrough — DISABLED by default. Never required.
ENABLE_CLOUD_INFERENCE=false
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Secrets provider: env | file | vault (default: env for local dev)
SECRETS_PROVIDER=env
